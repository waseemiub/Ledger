name: Build NedEx Offline Ledger V1.1

on:
  workflow_dispatch:
  push:
    paths:
      - 'NedEx_Offline_Ledger_V1_1_JVM17_FIXED.zip'
      - '.github/workflows/build-apk.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:

      # ==========================================
      # CHECKOUT
      # ==========================================
      - name: Checkout repository
        uses: actions/checkout@v4


      # ==========================================
      # JAVA 17
      # ==========================================
      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'


      # ==========================================
      # GRADLE 8.9
      # ==========================================
      - name: Set up Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'


      # ==========================================
      # VERIFY ZIP
      # ==========================================
      - name: Verify NedEx V1.1 package
        shell: bash
        run: |
          set -e

          ZIP="NedEx_Offline_Ledger_V1_1_JVM17_FIXED.zip"

          echo "========================================"
          echo "NEDEX OFFLINE LEDGER V1.1"
          echo "JVM 17 FIXED PACKAGE"
          echo "========================================"
          echo ""

          echo "Repository contents:"
          ls -lah

          echo ""

          if [ ! -f "$ZIP" ]; then
            echo "ERROR:"
            echo "$ZIP was not found."
            echo ""
            echo "Required exact filename:"
            echo "NedEx_Offline_Ledger_V1_1_JVM17_FIXED.zip"
            exit 1
          fi

          echo "ZIP FOUND:"
          ls -lh "$ZIP"

          echo ""
          echo "Testing ZIP integrity..."
          unzip -t "$ZIP"

          echo ""
          echo "ZIP integrity check passed."


      # ==========================================
      # EXTRACT
      # ==========================================
      - name: Extract NedEx V1.1
        shell: bash
        run: |
          set -e

          rm -rf extracted
          mkdir -p extracted

          unzip -q \
            NedEx_Offline_Ledger_V1_1_JVM17_FIXED.zip \
            -d extracted

          echo ""
          echo "========================================"
          echo "EXTRACTED PACKAGE"
          echo "========================================"

          find extracted \
            -maxdepth 6 \
            -type f \
            | sort \
            | head -300


      # ==========================================
      # DETECT PROJECT ROOT
      # ==========================================
      - name: Detect Android project root
        shell: bash
        run: |
          set -e

          EXPECTED="extracted/NedEx_Offline_Ledger_V1_1_JVM17_FIXED"

          echo ""
          echo "========================================"
          echo "DETECTING ANDROID PROJECT"
          echo "========================================"

          if [ -f "$EXPECTED/settings.gradle.kts" ]; then

            ROOT="$EXPECTED"

          elif [ -f "$EXPECTED/settings.gradle" ]; then

            ROOT="$EXPECTED"

          elif [ -f "extracted/settings.gradle.kts" ]; then

            ROOT="extracted"

          elif [ -f "extracted/settings.gradle" ]; then

            ROOT="extracted"

          else

            SETTINGS_KTS=$(find extracted \
              -type f \
              -name "settings.gradle.kts" \
              | head -1 || true)

            SETTINGS_GRADLE=$(find extracted \
              -type f \
              -name "settings.gradle" \
              | head -1 || true)

            if [ -n "$SETTINGS_KTS" ]; then
              ROOT=$(dirname "$SETTINGS_KTS")

            elif [ -n "$SETTINGS_GRADLE" ]; then
              ROOT=$(dirname "$SETTINGS_GRADLE")

            else
              echo ""
              echo "ERROR:"
              echo "Could not locate Android project."
              echo ""
              find extracted -maxdepth 5 -type d | sort
              exit 1
            fi

          fi

          echo ""
          echo "PROJECT ROOT:"
          echo "$ROOT"

          echo "PROJECT_ROOT=$ROOT" >> "$GITHUB_ENV"


      # ==========================================
      # VERIFY PROJECT
      # ==========================================
      - name: Verify Android project
        shell: bash
        run: |
          set -e

          echo ""
          echo "========================================"
          echo "ANDROID PROJECT CHECK"
          echo "========================================"

          echo "Project root:"
          echo "$PROJECT_ROOT"
          echo ""

          if [ -f "$PROJECT_ROOT/settings.gradle.kts" ]; then
            echo "settings.gradle.kts FOUND"
          elif [ -f "$PROJECT_ROOT/settings.gradle" ]; then
            echo "settings.gradle FOUND"
          else
            echo "ERROR: Settings file missing."
            exit 1
          fi

          if [ -f "$PROJECT_ROOT/build.gradle.kts" ]; then
            echo "build.gradle.kts FOUND"
          elif [ -f "$PROJECT_ROOT/build.gradle" ]; then
            echo "build.gradle FOUND"
          else
            echo "ERROR: Root build file missing."
            exit 1
          fi

          if [ -f "$PROJECT_ROOT/app/build.gradle.kts" ]; then
            echo "app/build.gradle.kts FOUND"
          elif [ -f "$PROJECT_ROOT/app/build.gradle" ]; then
            echo "app/build.gradle FOUND"
          else
            echo "ERROR: App build file missing."
            exit 1
          fi

          echo ""
          echo "Android project verified."


      # ==========================================
      # VERIFY VERSION
      # ==========================================
      - name: Verify NedEx V1.1
        shell: bash
        run: |
          set -e

          if [ -f "$PROJECT_ROOT/app/build.gradle.kts" ]; then
            FILE="$PROJECT_ROOT/app/build.gradle.kts"
          else
            FILE="$PROJECT_ROOT/app/build.gradle"
          fi

          echo ""
          echo "========================================"
          echo "VERSION CHECK"
          echo "========================================"

          grep -Eq \
            'versionCode[[:space:]]*=?[[:space:]]*2' \
            "$FILE"

          grep -Eq \
            'versionName[[:space:]]*=?[[:space:]]*["'\'']1\.1["'\'']' \
            "$FILE"

          echo "versionCode = 2"
          echo "versionName = 1.1"

          echo ""
          echo "V1.1 verified."


      # ==========================================
      # VERIFY APPLICATION ID
      # ==========================================
      - name: Verify application ID
        shell: bash
        run: |
          set -e

          if [ -f "$PROJECT_ROOT/app/build.gradle.kts" ]; then
            FILE="$PROJECT_ROOT/app/build.gradle.kts"
          else
            FILE="$PROJECT_ROOT/app/build.gradle"
          fi

          echo ""
          echo "========================================"
          echo "APPLICATION ID"
          echo "========================================"

          grep -Eq \
            'applicationId[[:space:]]*=?[[:space:]]*["'\'']ae\.nedex\.simpleledger["'\'']' \
            "$FILE"

          echo "ae.nedex.simpleledger"
          echo ""
          echo "Application ID verified."


      # ==========================================
      # VERIFY JVM 17 FIX
      # ==========================================
      - name: Verify JVM 17 configuration
        shell: bash
        run: |
          set -e

          FILE="$PROJECT_ROOT/app/build.gradle.kts"

          echo ""
          echo "========================================"
          echo "JVM 17 CONFIGURATION CHECK"
          echo "========================================"

          if [ ! -f "$FILE" ]; then
            echo "ERROR:"
            echo "Expected Kotlin Gradle file not found."
            exit 1
          fi

          grep -q 'JavaVersion.VERSION_17' "$FILE"
          grep -q 'jvmTarget = "17"' "$FILE"

          echo "Java target  = JVM 17"
          echo "Kotlin target = JVM 17"
          echo ""
          echo "JVM targets match."


      # ==========================================
      # GRADLE INFO
      # ==========================================
      - name: Show Gradle information
        working-directory: ${{ env.PROJECT_ROOT }}
        shell: bash
        run: |
          echo ""
          echo "========================================"
          echo "GRADLE INFORMATION"
          echo "========================================"

          gradle --version


      # ==========================================
      # CLEAN
      # ==========================================
      - name: Clean NedEx
        working-directory: ${{ env.PROJECT_ROOT }}
        shell: bash
        run: |
          set -e

          echo ""
          echo "========================================"
          echo "CLEANING NEDEX V1.1"
          echo "========================================"

          gradle clean --stacktrace


      # ==========================================
      # BUILD
      # ==========================================
      - name: Build NedEx V1.1 APK
        working-directory: ${{ env.PROJECT_ROOT }}
        shell: bash
        run: |
          set -e

          echo ""
          echo "========================================"
          echo "BUILDING NEDEX V1.1"
          echo "JAVA 17 + KOTLIN JVM 17"
          echo "========================================"

          gradle assembleDebug --stacktrace


      # ==========================================
      # LOCATE APK
      # ==========================================
      - name: Locate generated APK
        shell: bash
        run: |
          set -e

          echo ""
          echo "========================================"
          echo "SEARCHING FOR APK"
          echo "========================================"

          find "$PROJECT_ROOT/app/build/outputs" \
            -type f \
            -name "*.apk" \
            -print || true

          DEFAULT_APK="$PROJECT_ROOT/app/build/outputs/apk/debug/app-debug.apk"

          if [ -f "$DEFAULT_APK" ]; then

            APK="$DEFAULT_APK"

          else

            APK=$(find \
              "$PROJECT_ROOT/app/build/outputs/apk" \
              -type f \
              -name "*.apk" \
              | head -1 || true)

          fi

          if [ -z "$APK" ] || [ ! -f "$APK" ]; then

            echo ""
            echo "ERROR:"
            echo "APK was not generated."

            echo ""
            echo "Build output:"
            find "$PROJECT_ROOT/app/build" \
              -maxdepth 7 \
              -type f \
              | sort \
              | tail -250 || true

            exit 1
          fi

          echo ""
          echo "APK FOUND:"
          echo "$APK"

          ls -lh "$APK"

          echo "APK_PATH=$APK" >> "$GITHUB_ENV"


      # ==========================================
      # PREPARE FINAL APK
      # ==========================================
      - name: Prepare final NedEx APK
        shell: bash
        run: |
          set -e

          rm -rf release
          mkdir -p release

          cp \
            "$APK_PATH" \
            "release/NedEx-Offline-Ledger-V1.1.apk"

          echo ""
          echo "========================================"
          echo "FINAL APK"
          echo "========================================"

          ls -lh \
            "release/NedEx-Offline-Ledger-V1.1.apk"

          echo ""
          echo "========================================"
          echo "NEDEX V1.1 BUILD SUCCESSFUL"
          echo "========================================"


      # ==========================================
      # UPLOAD APK
      # ==========================================
      - name: Upload NedEx V1.1 APK
        uses: actions/upload-artifact@v4
        with:
          name: NedEx-Offline-Ledger-V1-1-APK
          path: release/NedEx-Offline-Ledger-V1.1.apk
          if-no-files-found: error
          retention-days: 30
